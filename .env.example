# Copy to .env (git-ignored) for live runs on the test bot: make live-echo, make live-agent.
# See docs/README.md, "Owner setup for live checks". Never commit the real values.

# Required.
# The test bot's token: @BotFather → /mybots → @ganglion_test_bot → API Token.
TELEGRAM_TEST_BOT_TOKEN=
# Your Telegram user id, for the admin entry; strangers get no reply.
GANGLION_ADMIN=telegram:user:

# Optional.
# A provider key a catalogue's key_env names (models.local.yaml); the default catalogue uses the
# claude CLI, logged in, and needs none.
# OPENROUTER_API_KEY=
# web.search through Brave; without it, DuckDuckGo (GANGLION_SEARCH=auto).
# BRAVE_API_KEY=
# The node's time zone, such as Europe/Kyiv; the system's when unset.
# GANGLION_TZ=
